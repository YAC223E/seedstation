[Unit]
Description=SeedStation stable mDNS name (seedstation.local)
After=network-online.target
Wants=network-online.target
PartOf=seedstation.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/scripts/mdns-alias.sh" @MDNS_NAME@
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=seedstation.target
