[Unit]
Description=SeedStation web application (Uvicorn + Django)
After=network-online.target seedstation-qbittorrent.service
Wants=network-online.target
PartOf=seedstation.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/backend
EnvironmentFile=@ROOT@/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre="@VENV@/bin/python" manage.py migrate --noinput
ExecStart="@VENV@/bin/uvicorn" config.asgi:application --host 0.0.0.0 --port @PORT@ --ws websockets-sansio
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=seedstation.target
