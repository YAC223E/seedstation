# SeedStation environment template.
#
# Recommended: run ./scripts/setup.sh, which creates a private .env with
# generated secrets. Copy this file only if you prefer to fill values yourself.
#
# Keep .env private (chmod 600). Values are shell-compatible; single or double
# quotes are accepted around values that contain spaces.

# --- Core -------------------------------------------------------------------
# Required. Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SEEDSTATION_SECRET_KEY=
SEEDSTATION_DEBUG=false
SEEDSTATION_PORT=8000
# mDNS alias published by seedstation-mdns.service (used by ./scripts/install-systemd.sh).
SEEDSTATION_MDNS_NAME=seedstation.local
SEEDSTATION_TIME_ZONE=UTC

# Extra Host header names. Loopback, private IPs and *.local are allowed
# automatically by the LAN host middleware.
SEEDSTATION_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed for the optional Vite dev server. Same-origin production does
# not use CORS or cross-origin CSRF origins.
SEEDSTATION_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEEDSTATION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trusted-LAN default. Set false only behind a reverse proxy with your own
# access control; this app is not hardened for the public internet.
SEEDSTATION_LAN_ONLY=true
# Set true only after adding HTTPS (cookies become Secure).
SEEDSTATION_SECURE_COOKIES=false

# --- Storage ----------------------------------------------------------------
# Absolute path. Must exist or be creatable by the user running SeedStation.
SEEDSTATION_DOWNLOAD_DIR="/home/you/seedstation/storage/downloads"
# Optional comma-separated additional read/write roots.
SEEDSTATION_EXTRA_DIRS=

# --- Administrator ----------------------------------------------------------
# Used to create the account on first setup. Later password changes are made
# in the SeedStation Settings page.
SEEDSTATION_ADMIN_USERNAME=admin
SEEDSTATION_ADMIN_EMAIL=admin@seedstation.local
SEEDSTATION_ADMIN_PASSWORD=

# --- qBittorrent engine -----------------------------------------------------
# The WebUI must stay on loopback. SeedStation is the only API client.
SEEDSTATION_QBIT_HOST=127.0.0.1
SEEDSTATION_QBIT_PORT=8081
SEEDSTATION_QBIT_TORRENT_PORT=6881
SEEDSTATION_QBIT_USERNAME=seedstation
SEEDSTATION_QBIT_PASSWORD=
SEEDSTATION_QBIT_CONNECT_TIMEOUT=3
SEEDSTATION_QBIT_READ_TIMEOUT=12

# --- Logging ----------------------------------------------------------------
SEEDSTATION_LOG_LEVEL=INFO
